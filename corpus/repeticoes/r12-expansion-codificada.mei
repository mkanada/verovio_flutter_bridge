<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="4.0.1">
  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>r12 expansion codificada (MEI)</title>
      </titleStmt>
      <pubStmt/>
    </fileDesc>
  </meiHead>
  <music>
    <body>
      <mdiv>
        <score>
          <scoreDef meter.count="4" meter.unit="4" key.sig="0">
            <staffGrp>
              <staffDef n="1" lines="5" clef.shape="G" clef.line="2"/>
            </staffGrp>
          </scoreDef>
          <section>
            <section xml:id="grpA">
              <measure n="1" xml:id="m1">
                <staff n="1">
                  <layer n="1">
                  <note xml:id="m1n1" pname="c" oct="4" dur="4"/>
                  <note xml:id="m1n2" pname="e" oct="4" dur="4"/>
                  <note xml:id="m1n3" pname="g" oct="4" dur="4"/>
                  <note xml:id="m1n4" pname="b" oct="4" dur="4"/>
                  </layer>
                </staff>
              </measure>
              <measure n="2" xml:id="m2">
                <staff n="1">
                  <layer n="1">
                  <note xml:id="m2n1" pname="d" oct="4" dur="4"/>
                  <note xml:id="m2n2" pname="f" oct="4" dur="4"/>
                  <note xml:id="m2n3" pname="a" oct="4" dur="4"/>
                  <note xml:id="m2n4" pname="c" oct="5" dur="4"/>
                  </layer>
                </staff>
              </measure>
            </section>
            <section xml:id="grpB">
              <measure n="3" xml:id="m3">
                <staff n="1">
                  <layer n="1">
                  <note xml:id="m3n1" pname="e" oct="4" dur="4"/>
                  <note xml:id="m3n2" pname="g" oct="4" dur="4"/>
                  <note xml:id="m3n3" pname="b" oct="4" dur="4"/>
                  <note xml:id="m3n4" pname="c" oct="4" dur="4"/>
                  </layer>
                </staff>
              </measure>
            </section>
            <expansion xml:id="exp-repete" plist="#grpA #grpA #grpB"/>
            <expansion xml:id="exp-sem-repeticao" plist="#grpA #grpB"/>
          </section>

        </score>
      </mdiv>
    </body>
  </music>
</mei>
